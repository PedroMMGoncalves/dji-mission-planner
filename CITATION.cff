    given-names: "Pedro"
    affiliation: "LNEG — Laboratório Nacional de Energia e Geologia"
version: 1.0.0
date-released: 2026-09-01
license: GPL-3.0-only
repository-code: "https://github.com/PedroMMGoncalves/dji-mission-planner"
