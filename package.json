{
  "name": "dji-mission-planner",
  "private": true,
  "version": "1.1.0",
  "description": "Browser-based drone mapping mission planner for DJI Pilot 2 (KML / WPML KMZ export)",
  "license": "GPL-3.0-only",
  "author": "Pedro Goncalves",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroMMGoncalves/dji-mission-planner.git"
  },
  "homepage": "https://pedrommgoncalves.github.io/dji-mission-planner/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"tests/**/*.mjs\" \"scripts/*.mjs\" \"tools/*.mjs\" \"*.mjs\" \"*.json\" tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"tests/**/*.mjs\" \"scripts/*.mjs\" \"tools/*.mjs\" \"*.mjs\" \"*.json\" tsconfig.json",
    "test": "npm run test:smoke && npm run test:unit",
    "test:update-golden": "UPDATE_GOLDEN=1 node smoke-test.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:smoke": "node smoke-test.mjs && node smoke-test-io.mjs",
    "test:unit": "vitest run",
    "test:coverage": "c8 --include \"src/utils/**\" --reporter=text-summary --reporter=text --check-coverage --lines 92 --functions 90 --branches 82 npm run test:smoke"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "geotiff": "^2.1.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "proj4": "^2.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shpjs": "^6.2.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exifr": "^7.1.3",
    "fast-check": "^4.9.0",
    "fast-xml-parser": "^5.11.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
